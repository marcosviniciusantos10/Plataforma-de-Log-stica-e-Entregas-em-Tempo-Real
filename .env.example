# Copie para .env e preencha os valores: cp .env.example .env
#
# Os segredos (senhas e JWT_SECRET) ficam VAZIOS de propósito: a aplicação e o
# docker compose se recusam a subir sem eles. Gere cada um com:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# Aplicação
APP_NAME=logistica-api
APP_ENV=development
API_PORT=8000

# PostgreSQL / PostGIS
POSTGRES_USER=logistica
POSTGRES_PASSWORD=
POSTGRES_DB=logistica
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=logistica
RABBITMQ_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Autenticação (JWT)
# Mínimo de 32 caracteres; gere com o comando acima
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
