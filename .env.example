# Copie para .env e ajuste os valores: cp .env.example .env

# Aplicação
APP_NAME=logistica-api
APP_ENV=development
API_PORT=8000

# PostgreSQL / PostGIS
POSTGRES_USER=logistica
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=logistica
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=troque-esta-senha
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=logistica
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
